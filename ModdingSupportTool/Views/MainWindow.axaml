<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModdingSupportTool.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="840"
        x:Class="ModdingSupportTool.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Title="Modding Support Tool - MelonLoader 모드 레퍼런스 생성기"
        Width="1000" Height="900"
        MinWidth="860" MinHeight="720"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, *" Margin="16">

        <!-- 1. Header / Engine Selection & Export Button -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Assembly C# Dumper" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="MelonLoader 모드(DLL)용 C# 레퍼런스 · Unity 전용 (Unreal은 UE4SS)"
                               FontSize="12" Foreground="#888888" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Right Header: Engine Radio Group & Export Tool Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#1E1E1E" CornerRadius="6" Padding="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton Content="SignatureDumper (앱 내장)"
                                         GroupName="DumpEngineGroup"
                                         IsChecked="{Binding IsSignatureDumperSelected, Mode=TwoWay}"
                                         Padding="8,4" />
                            <RadioButton Content="ilspycmd (Mono)"
                                         GroupName="DumpEngineGroup"
                                         IsChecked="{Binding IsIlSpySelected, Mode=TwoWay}"
                                         Padding="8,4" />
                        </StackPanel>
                    </Border>

                    <Button Content="📦 SignatureDumper 소스 내보내기"
                            Command="{Binding ExportSignatureDumperCommand}"
                            Background="#383838" Foreground="#E0E0E0"
                            Padding="10,6" ToolTip.Tip="앱에 내장된 덤퍼 코어와 똑같은 소스로 독립 실행형 SignatureDumper 프로젝트(net472;net8.0)를 만듭니다." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Input Assembly Settings -->
        <Border Grid.Row="1" Background="#252526" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel Spacing="8">
                <TextBlock Text="입력 어셈블리 설정" FontWeight="SemiBold" FontSize="14" Foreground="#E0E0E0" />

                <!-- Input Path -->
                <Grid ColumnDefinitions="*, 8, Auto, 6, Auto">
                    <TextBox Grid.Column="0" Text="{Binding InputPath}"
                             PlaceholderText="게임 설치 폴더, 어셈블리 폴더(Il2CppAssemblies / Managed) 또는 DLL 파일 경로" />
                    <Button Grid.Column="2" Content="폴더 선택" Command="{Binding SelectInputFolderCommand}" />
                    <Button Grid.Column="4" Content="DLL 파일 선택" Command="{Binding SelectInputFileCommand}" />
                </Grid>

                <!-- Backend Detection Status Banner -->
                <Border Background="#1C1C1E" CornerRadius="6" Padding="10,6" BorderBrush="#333333" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto, 8, Auto, 8, *, Auto, 12, Auto">
                        <TextBlock Grid.Column="0" Text="엔진 판별:" FontWeight="SemiBold" FontSize="12" Foreground="#888888" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="#0E3D30" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DetectedBackendText}" FontSize="11" FontWeight="Bold" Foreground="#4EC9B0" />
                        </Border>
                        <TextBlock Grid.Column="4" Text="{Binding DetectionReasonText}" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DetectionReasonText}" />

                        <CheckBox Grid.Column="5" Content="백엔드 기반 엔진 자동 전환" IsChecked="{Binding IsAutoDetectEnabled}" FontSize="12" VerticalAlignment="Center" />
                        <Button Grid.Column="7" Content="재판별" Command="{Binding TriggerAutoDetectCommand}" FontSize="11" Padding="8,3" />
                    </Grid>
                </Border>

                <!-- Quick Rhythm Game Presets (PresetService 목록에서 생성, 이 PC에 없는 경로는 비활성화) -->
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="리듬게임 프리셋:" FontSize="12" Foreground="#888888" VerticalAlignment="Top" Margin="0,5,8,0" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PresetItem">
                                <Button Content="{Binding DisplayName}" FontSize="11" Padding="8,4" Margin="0,0,6,4"
                                        Command="{Binding ApplyCommand}" IsEnabled="{Binding Exists}"
                                        ToolTip.Tip="{Binding ToolTip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Target Assemblies -->
                <Grid ColumnDefinitions="140, *">
                    <TextBlock Grid.Column="0" Text="대상 어셈블리:" VerticalAlignment="Center" FontSize="12" Foreground="#AAAAAA" />
                    <TextBox Grid.Column="1" Text="{Binding TargetAssemblies}"
                             PlaceholderText="Assembly-CSharp.dll, Assembly-CSharp-firstpass.dll (쉼표로 구분)" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Output & Options -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel Spacing="8">
                <TextBlock Text="출력 위치 및 엔진 옵션" FontWeight="SemiBold" FontSize="14" Foreground="#E0E0E0" />

                <!-- Output Path -->
                <Grid ColumnDefinitions="*, 8, Auto, 6, Auto">
                    <TextBox Grid.Column="0" Text="{Binding OutputPath}"
                             PlaceholderText="디컴파일/덤프 결과를 저장할 출력 폴더를 지정하세요" />
                    <Button Grid.Column="2" Content="출력 폴더 선택" Command="{Binding SelectOutputFolderCommand}" />
                    <Button Grid.Column="4" Content="탐색기 열기" Command="{Binding OpenOutputFolderCommand}" />
                </Grid>

                <!-- Engine specific options -->
                <StackPanel Spacing="8">
                    <!-- SignatureDumper options -->
                    <Border Background="#1E1E1E" CornerRadius="4" Padding="10,6" IsVisible="{Binding IsSignatureDumperSelected}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="⚡ SignatureDumper 코어가 앱 내부에 내장(In-Process)되어 외부 종속성 없이 바로 실행됩니다."
                                       FontSize="12" Foreground="#4EC9B0" TextWrapping="Wrap" />
                            <CheckBox Content="Il2CppInterop 내부 멤버도 출력 (NativeFieldInfoPtr_/NativeMethodInfoPtr_ 필드, IntPtr 생성자)"
                                      IsChecked="{Binding IncludeInteropMembers}" FontSize="12"
                                      ToolTip.Tip="기본은 생략합니다. 모드 작성에 쓰이지 않는 런타임 연결용 멤버로, Il2Cpp 덤프 크기의 절반가량을 차지합니다." />
                        </StackPanel>
                    </Border>

                    <!-- ilspycmd options -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsIlSpySelected}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="프로젝트 파일 생성 (-p)" IsChecked="{Binding IlSpyCreateProject}" />
                            <CheckBox Content="네임스페이스 폴더 분할 (--nested-directories)" IsChecked="{Binding IlSpyNestedDirectories}" />
                        </StackPanel>

                        <Border Background="#1E1E1E" CornerRadius="4" Padding="10,6">
                            <Grid ColumnDefinitions="*, Auto">
                                <CheckBox Grid.Column="0"
                                          Content="🤖 AI 토큰 절약용 아웃라인 동시 생성 (메서드 본문 비우기 -> _Outline 폴더)"
                                          IsChecked="{Binding GenerateAiOutline}"
                                          VerticalAlignment="Center"
                                          FontSize="12"
                                          ToolTip.Tip="디컴파일 후 Roslyn으로 메서드·접근자 본문을 지운 경량 소스를 _Outline 폴더에 함께 만듭니다. 절감률은 완료 로그에 표시됩니다." />
                                <Button Grid.Column="1" Content="아웃라인 폴더 열기"
                                        Command="{Binding OpenOutlineFolderCommand}"
                                        FontSize="11" Padding="8,3"
                                        IsVisible="{Binding HasOutlineFolder}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 4. AI Agent Integration (MCP + Skills) -->
        <Border Grid.Row="3" Background="#252526" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="AI 에이전트 연동 (MCP · 스킬)" FontWeight="SemiBold" FontSize="14" Foreground="#E0E0E0" />
                    <TextBlock Text="Claude Code · Antigravity(agy) · Gemini CLI에 스킬(MD)을 설치하고 이 도구를 MCP 서버로 등록합니다."
                               FontSize="12" Foreground="#888888" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="🤖 AI 에이전트에 설치" Command="{Binding InstallAgentCommand}"
                            Background="#3A2D5C" Foreground="#FFFFFF" Padding="12,6"
                            ToolTip.Tip="이 PC에서 감지된 에이전트의 사용자 스킬 폴더에 스킬을 쓰고 MCP 서버를 등록합니다. 에이전트를 다시 시작하면 적용됩니다." />
                    <Button Content="연동 상태" Command="{Binding ShowAgentStatusCommand}" Padding="10,6" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto, 8, *" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" Text="MCP 명령:" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding McpCommandText, Mode=OneWay}" IsReadOnly="True" FontSize="11"
                             FontFamily="Cascadia Code, Consolas, Courier New" />
                </Grid>
            </Grid>
        </Border>

        <!-- 5. Execution Controls -->
        <Border Grid.Row="4" Background="#252526" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto, 8, Auto, 8, Auto, *, Auto">
                <Button Grid.Column="0" Content="덤프 시작"
                        Command="{Binding StartDumpCommand}"
                        Background="#0E639C" Foreground="#FFFFFF"
                        FontWeight="Bold" Padding="16,8" />
                <Button Grid.Column="2" Content="작업 중지"
                        Command="{Binding CancelDumpCommand}"
                        Background="#C5221F" Foreground="#FFFFFF"
                        Padding="14,8" />
                <Button Grid.Column="4" Content="로그 비우기"
                        Command="{Binding ClearLogCommand}"
                        Padding="12,8" />

                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="{Binding IsBusy}"
                                 IsVisible="{Binding IsBusy}"
                                 Width="120" Height="6" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontWeight="SemiBold"
                               Foreground="#569CD6"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 6. Real-time Output Log Terminal -->
        <Border Grid.Row="5" Background="#181818" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Padding="10" MinHeight="150">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="실시간 실행 로그" FontSize="11" Foreground="#666666" Margin="4,0,0,6" />
                <ScrollViewer Grid.Row="1" x:Name="LogScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding LogOutput}"
                             IsReadOnly="True"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#D4D4D4"
                             TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</Window>
